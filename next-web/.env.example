NEXT_APP_URL=http://localhost:3100
SAML_ENTRY_POINT=https://login.microsoftonline.com/YOUR_TENANT_ID/saml2
SAML_IDP_ISSUER=https://sts.windows.net/YOUR_TENANT_ID/
# Existing SAML login sample entity ID; add the Next.js reply URL to that enterprise app
SAML_ISSUER=http://localhost:3000/saml/metadata
SAML_CERT_PATH=../backend/certs/entra.cer
DATABASE_PATH=../backend/data/shared.sqlite
SHARED_SCHEMA_PATH=../backend/db

# Optional rollover: JSON array, overrides SAML_CERT / SAML_CERT_PATH
# SAML_CERT_PATHS=["../backend/certs/entra.cer","../backend/certs/entra-next.cer"]

# Automatic Entra signing certificate refresh (optional)
# SAML_METADATA_URL=https://login.microsoftonline.com/<tenant-id>/federationmetadata/2007-06/federationmetadata.xml?appid=<SAML-enterprise-app-application-id>
# SAML_METADATA_CACHE_PATH=/app/data/entra-metadata.xml
# SAML_METADATA_REFRESH_MS=86400000
