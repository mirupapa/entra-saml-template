PORT=3000
FRONTEND_URL=http://localhost:5173
SAML_ENTRY_POINT=https://login.microsoftonline.com/YOUR_TENANT_ID/saml2
# SP Entity ID (Entra の Identifier と一致)
SAML_ISSUER=http://localhost:3000/saml/metadata
# Entra の Microsoft Entra Identifier をそのまま転記 (末尾 / を含む)
SAML_IDP_ISSUER=https://sts.windows.net/YOUR_TENANT_ID/
SAML_CALLBACK_URL=http://localhost:3000/auth/saml/callback
# ダウンロードした Certificate (Base64) のパス、backend/ からの相対パス
SAML_CERT_PATH=./certs/entra.cer
# openssl rand -hex 32 で生成
SESSION_SECRET=
# HTTPS 環境では true。HTTP localhost では false
COOKIE_SECURE=false
# 信頼するリバースプロキシが1段の場合のみ true
TRUST_PROXY=false

# Backend作業ディレクトリからのパス。Web/Expo共通の永続ユーザーDB
DATABASE_PATH=./data/shared.sqlite

# Graph: app-only permissions User.Invite.All, AppRoleAssignment.ReadWrite.All, Application.Read.All
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TARGET_SERVICE_PRINCIPAL_ID=
# Optional: invitation redemption landing page (reachable HTTPS)
GRAPH_INVITE_REDIRECT_URL=https://myapps.microsoft.com/
# Required only if target defines enabled user app roles
GRAPH_TARGET_APP_ROLE_ID=

# Optional rollover: JSON array, overrides SAML_CERT / SAML_CERT_PATH
# SAML_CERT_PATHS=["./certs/entra.cer","./certs/entra-next.cer"]

# Automatic Entra signing certificate refresh (optional)
# SAML_METADATA_URL=https://login.microsoftonline.com/<tenant-id>/federationmetadata/2007-06/federationmetadata.xml?appid=<SAML-enterprise-app-application-id>
# SAML_METADATA_CACHE_PATH=/app/data/entra-metadata.xml
# SAML_METADATA_REFRESH_MS=86400000
